# Medveris local development configuration. Copy to .env. Replace placeholder values as documented.
# After copying, run: npm run db:setup && npm run db:migrate && npm run db:seed
# Then: npm run dev

# Application environment
NODE_ENV=development
APP_ENV=development
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8787
PORT=8787

# PostgreSQL local roles. Production must use secret-managed credentials.
# After npm run db:setup, these roles and databases will be created.
PGADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
DATABASE_URL=postgres://medveris_runtime:REPLACE_WITH_32_CHAR_PASSWORD@localhost:5432/medveris_dev
MIGRATION_DATABASE_URL=postgres://medveris_migrator:REPLACE_WITH_32_CHAR_PASSWORD@localhost:5432/medveris_dev
JOBS_DATABASE_URL=postgres://medveris_jobs:REPLACE_WITH_32_CHAR_PASSWORD@localhost:5432/medveris_dev

# Role passwords used only by `npm run db:setup` when it creates roles (optional; local defaults apply).
# Generate with: openssl rand -base64 32
MIGRATOR_PASSWORD=REPLACE_WITH_32_CHAR_PASSWORD
RUNTIME_PASSWORD=REPLACE_WITH_32_CHAR_PASSWORD
JOBS_PASSWORD=REPLACE_WITH_32_CHAR_PASSWORD

# Secrets. `npm run secrets:local` fills missing values with `openssl rand -base64 32`
# and keeps existing ones. Placeholder values are rejected at startup.
# Generate secrets with: openssl rand -base64 32
SESSION_SECRET=REPLACE_WITH_32_RANDOM_CHARS
AUDIT_SIGNING_KEY=REPLACE_WITH_32_RANDOM_CHARS
MFA_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_CHARS
AUDIT_SIGNING_KEY_ID=local-dev-key-1
SESSION_TTL_MINUTES=480
CSRF_HEADER=x-medveris-csrf

# Email delivery. local = write .eml files to .mail-sink; resend requires configuration.
EMAIL_ADAPTER=local
MAIL_SINK_DIR=.mail-sink
EMAIL_FROM=Medveris <no-reply@medveris.local>
RESEND_API_KEY=REPLACE_WITH_RESEND_KEY
RESEND_FROM=

# Platform operator grants (four-eyes approval workflow).
# Default grant duration; requests without durationHours use this.
PLATFORM_ROLE_DEFAULT_GRANT_HOURS=24
# Hard ceiling for any grant, including break-glass.
PLATFORM_ROLE_MAX_GRANT_HOURS=168
# A session counts as recently step-up verified within this window for privilege changes.
PLATFORM_ROLE_RECENT_MFA_SECONDS=300
# Below this many active operators the platform is considered understaffed.
PLATFORM_ROLE_MIN_ACTIVE_OPERATORS=2
# Comma separated environments where the retired direct elevate/revoke endpoints keep
# working. Leave empty everywhere except local synthetic tooling. "production" is refused.
PLATFORM_ROLE_LEGACY_ELEVATE_ENVIRONMENTS=

# Private object storage: local = filesystem under .data/uploads; r2 = Cloudflare R2 binding.
STORAGE_ADAPTER=local
LOCAL_UPLOAD_DIR=.data/uploads
MAX_UPLOAD_BYTES=5242880

# Terminology: synthetic (development/test only, refused in production), production (needs
# TERMINOLOGY_PROVIDER_URL) or unavailable (every terminology operation returns 503).
TERMINOLOGY_MODE=synthetic
TERMINOLOGY_PROVIDER_URL=
TERMINOLOGY_PROVIDER_TOKEN=
TERMINOLOGY_TIMEOUT_MS=5000
SNOMED_EDITION_URI=
LOINC_RELEASE=

# FHIR. External writes and bulk export remain disabled in the MVP.
FHIR_EXTERNAL_WRITES_ENABLED=false
FHIR_BULK_EXPORT_ENABLED=false

# Feature flags for later integrations. They remain disabled until configured and accepted.
# To enable any feature: 1) Set the flag to true, 2) Configure required credentials, 3) Run the appropriate gate check.
FEATURE_DICOMWEB=false
FEATURE_LAB=false
FEATURE_PHARMACY=false
FEATURE_TELEMEDICINE=false
FEATURE_DEVICES=false
FEATURE_PAYMENTS=false
FEATURE_PUBLIC_HEALTH=false

# Cloudflare Workers AI. AI is included in every subscription package; this flag is the environment
# / compliance gate, not a plan entitlement. The Worker gets the `AI` binding from wrangler.jsonc,
# so no API key is needed here. Keep FEATURE_AI=false until the risk, privacy and clinical evaluation
# reviews are approved. The centralized service in @medveris/ai degrades to "unconfigured" when the
# binding is absent, the flag is off, or inference fails.
FEATURE_AI=false
# Workers AI model id used by the centralized service (config-driven, never hardcoded in routes).
AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
# Maximum combined input budget in tokens (256-8192). Longer prompts/context are truncated.
AI_INPUT_TOKENS_MAX=4096
# Default generation cap in tokens (1-8192).
AI_MAX_TOKENS=1024
# Default sampling temperature (0-1).
AI_TEMPERATURE=0.2
# Per-attempt inference timeout in milliseconds (1000-60000). The service retries twice.
AI_TIMEOUT_MS=15000

# PACS / DICOMweb. FEATURE_DICOMWEB=true plus a complete connection enables QIDO-RS search and
# WADO-RS rendered-frame review. The integration stays unavailable until a platform operator runs a
# passing conformance check from Admin -> Integrations (POST /api/v1/admin/integrations/dicomweb/verify).
# See docs/22_PACS_DICOMWEB_RUNBOOK.md. Use `npm run pacs:mock` for a local synthetic PACS.
# DICOMWEB_BASE_URL: DICOMweb root, e.g. https://pacs.example.org/dicom-web (no trailing slash,
# no credentials, no query). HTTP is accepted only in development and tests.
# Set DICOMWEB_BASE_URL and DICOMWEB_AUTH before enabling.
DICOMWEB_BASE_URL=
# DICOMWEB_AUTH: none | basic | bearer. "none" is refused outside development and tests.
DICOMWEB_AUTH=none
# Basic credentials (Worker secrets in staging and production).
# Set DICOMWEB_USERNAME and DICOMWEB_PASSWORD before enabling.
DICOMWEB_USERNAME=
DICOMWEB_PASSWORD=
# Bearer token when DICOMWEB_AUTH=bearer (Worker secret in staging and production).
DICOMWEB_BEARER_TOKEN=
DICOMWEB_TIMEOUT_MS=15000
# Largest rendered frame relayed to a browser (256 KiB to 64 MiB).
DICOMWEB_MAX_IMAGE_BYTES=20971520
# A passing verification older than this no longer makes the PACS available.
DICOMWEB_VERIFICATION_MAX_AGE_DAYS=30

# Yo! Payments mobile money (point of sale). FEATURE_PAYMENTS=true plus everything below enables it.
# YO_MODE: disabled | sandbox (https://sandbox.yo.co.ug/services/yopaymentsdev/task.php, refused in production)
#          | production (https://paymentsapi1.yo.co.ug/ybs/task.php, backup paymentsapi2 for status checks).
# Set FEATURE_PAYMENTS=true, YO_MODE, and the API credentials before enabling.
YO_MODE=disabled
# Business API credentials from the Yo! Payments account (Worker secrets in staging/production).
# Set before enabling FEATURE_PAYMENTS.
YO_API_USERNAME=REPLACE_WITH_USERNAME
YO_API_PASSWORD=REPLACE_WITH_PASSWORD
# Yo!'s public certificate for the selected mode (Yo_Uganda_Public_Sandbox_Certificate.crt or
# Yo_Uganda_Public_Certificate.crt from github.com/YO-Uganda/YoPaymentsPHP), PEM. Newlines may be written as \n.
# Payment notifications are rejected without it.
YO_PUBLIC_KEY=REPLACE_WITH_PEM_CERTIFICATE
# Optional overrides. Notifications are sent to <YO_NOTIFICATION_BASE_URL>/api/v1/public/payments/yo/notifications
# and /failures; the base defaults to APP_ORIGIN and must be a public HTTPS origin Yo! can reach.
YO_API_URL=
YO_BACKUP_API_URL=
YO_NOTIFICATION_BASE_URL=
YO_TIMEOUT_MS=30000

# LivePay payment provider. The API key and webhook secret are Worker secrets;
# only the endpoint URL is a plaintext var.
# LivePay is the primary subscription provider. Yo! remains disabled until its production access
# and adapter are verified.
# PAYMENT_PROVIDER selects the adapter: livepay (primary) or yo (future alternative).
PAYMENT_PROVIDER=livepay
# Upstream REST API root. LivePay has no test mode; do not point this at a "test" host.
LIVEPAY_BASE_URL=https://livepay.me/api
# The business account number that receives collections (not a secret).
LIVEPAY_ACCOUNT_NUMBER=LP0000000000
# The exact inbound URL LivePay posts to. It is part of the webhook signature and must match the
# URL registered with LivePay, character for character.
LIVEPAY_WEBHOOK_URL=http://localhost:5173/api/v1/public/payments/livepay/webhook
LIVEPAY_API_KEY=REPLACE_WITH_API_KEY
LIVEPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# Self-service subscription checkout: USD 0.50 per active user for the chosen period (day, week,
# month, quarter or year), collected in UGX. The UGX amount is computed on the server and never
# hardcoded. A live provider (FX_PROVIDER/FX_API_KEY above) is preferred; the operator rate below is
# used only when no provider is available and is disclosed as operator-configured. A provider rate
# older than SUBSCRIPTION_FX_MAX_AGE_MINUTES is refused rather than priced.
SUBSCRIPTION_PRODUCT_DESCRIPTION=Medveris workspace access for all modules enabled in the workspace
SUBSCRIPTION_MIN_UGX=500
SUBSCRIPTION_FX_USD_UGX=
SUBSCRIPTION_FX_MAX_AGE_MINUTES=1440

FEATURE_LEDGER_ANCHORING=false

# Emergency access policy values. Production values require governance approval.
EMERGENCY_OVERRIDE_MINUTES=60
EMERGENCY_REVIEW_DUE_HOURS=24
# Minutes before an unacknowledged critical imaging finding is flagged overdue (facility policy).
RADIOLOGY_CRITICAL_ACK_MINUTES=60

# Local-only MFA convenience is never enabled by default.
DEV_SHOW_TOTP_SECRETS=false

# Scaling and resilience (docs/implementation/SCALABILITY_AND_RESILIENCE.md). Defaults are safe.
# Read replica: needs a provider-provisioned standby and a HYPERDRIVE_REPLICA binding.
DB_REPLICA_ENABLED=false
DB_REPLICA_MAX_LAG_MS=5000
DB_READ_YOUR_WRITES_MS=15000
DB_REPLICA_HEALTH_TTL_MS=5000
DB_REPLICA_HEALTH_TIMEOUT_MS=1000
# Shard topology JSON; empty means the single shard "primary". Multi-shard topologies are refused.
SHARD_TOPOLOGY=
# Bump to invalidate every Worker-cache key without a release.
CACHE_KEY_EPOCH=1
# Fraction of successful fast requests logged (errors, 429s and slow requests are always logged).
REQUEST_LOG_SAMPLE_RATE=1
# Cloudflare observability (platform dashboard only). CLOUDFLARE_API_TOKEN is a Worker secret in
# staging/production with Account Read permission on Logs/Workers/Analytics; never commit it and
# never expose it to the browser. Leave CLOUDFLARE_OBSERVABILITY_ENABLED=false until the token is
# provisioned; the observability endpoints then return a structured "unavailable" envelope.
CLOUDFLARE_OBSERVABILITY_ENABLED=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TIMEOUT_MS=10000
CLOUDFLARE_CACHE_TTL_MS=60000
# Live updates over WebSockets (Workers only). Clinical event types need governance approval.
REALTIME_ENABLED=false
REALTIME_ALLOWED_ORIGINS=
REALTIME_EVENT_TYPES=content.published,job.progress
REALTIME_TICKET_TTL_SECONDS=30
REALTIME_MAX_CONNECTION_SECONDS=900
# JSON array of {policy, factor (0.1-10), expiresAt (<= 7 days), reason}; deployment-audited.
RATE_LIMIT_OVERRIDES=
# Trust X-Forwarded-For only behind a proxy you control (always trusted in development/test).
TRUST_FORWARDED_FOR=false
JOBS_RELAY_BATCH_SIZE=100
JOBS_PER_TENANT_BATCH_LIMIT=25
