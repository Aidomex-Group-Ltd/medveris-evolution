        "properties": {
          "patientId": {
            "type": "string",
            "format": "uuid"
          },
          "identityConfirmed": {
            "const": true
          },
          "displayLabel": {
            "type": "string",
            "maxLength": 200,
            "description": "Minimum permitted identity label; role-filtered."
          }
        }
      },
      "EncounterCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "patientId",
          "facilityId",
          "type"
        ],
        "properties": {
          "patientId": {
            "type": "string",
            "format": "uuid"
          },
          "facilityId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "enum": [
              "outpatient",
              "emergency",
              "inpatient",
              "telehealth"
            ]
          },
          "appointmentId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Encounter": {
        "type": "object",
        "required": [
          "id",
          "patientId",
          "state",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "patientId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "enum": [
              "planned",
              "arrived",
              "triaged",
              "in-progress",
              "completed",
              "cancelled",
              "entered-in-error"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "AmendmentCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expectedVersion",
          "changeNote",
          "contentSchema",
          "content"
        ],
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          },
          "changeNote": {
            "type": "string",
            "minLength": 5,
            "maxLength": 2000
          },
          "contentSchema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "content": {
            "type": "object"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EntryVersionReceipt": {
        "type": "object",
        "required": [
          "entryId",
          "versionId",
          "version",
          "recordedAt"
        ],
        "properties": {
          "entryId": {
            "type": "string",
            "format": "uuid"
          },
          "versionId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ConsentRevoke": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expectedVersion",
          "reason"
        ],
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 5,
            "maxLength": 1000
          }
        }
      },
      "ExchangeRecord": {
        "type": "object",
        "required": [
          "entryId",
          "versionId",
          "sourceTenantId",
          "authorId",
          "occurredAt",
          "category",
          "content"
        ],
        "properties": {
          "entryId": {
            "type": "string",
            "format": "uuid"
          },
          "versionId": {
            "type": "string",
            "format": "uuid"
          },
          "sourceTenantId": {
            "type": "string",
            "format": "uuid"
          },
          "authorId": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "content": {
            "type": "object"
          }
        }
      },
      "ExchangePage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/ExchangeRecord"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
